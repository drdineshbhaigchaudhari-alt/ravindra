{
  "name": "ravindra-medical-research-university",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "start": "node server/index.js",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0"
  },
  "devDependencies": { "concurrently": "^9.0.1" }
}
